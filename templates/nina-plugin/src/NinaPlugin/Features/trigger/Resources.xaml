<ResourceDictionary x:Class="TemplateNamespace.Features.trigger.Resources"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="clr-namespace:TemplateNamespace.Features.trigger"
    xmlns:nina="clr-namespace:NINA.View.Sequencer;assembly=NINA.Sequencer"
    xmlns:logic="clr-namespace:NINA.Sequencer.Logic;assembly=NINA.Sequencer">
    <DataTemplate DataType="{x:Type local:PeriodicTrigger}">
        <nina:SequenceBlockView>
            <nina:SequenceBlockView.SequenceItemContent>
                <StackPanel>
                    <StackPanel Orientation="Horizontal"><TextBlock Text="After this many instructions: " /><TextBox Width="60" Text="{Binding Interval, ValidatesOnExceptions=True}" /></StackPanel>
                    <nina:SequenceContainerView DataContext="{Binding TriggerRunner}" />
                </StackPanel>
            </nina:SequenceBlockView.SequenceItemContent>
        </nina:SequenceBlockView>
    </DataTemplate>
    <DataTemplate x:Key="TemplateNamespace.Features.trigger.PeriodicTrigger_Mini">
        <TextBlock Text="{Binding Name}" />
    </DataTemplate>
</ResourceDictionary>
