<ResourceDictionary x:Class="TemplateNamespace.Features.condition.Resources"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="clr-namespace:TemplateNamespace.Features.condition"
    xmlns:nina="clr-namespace:NINA.View.Sequencer;assembly=NINA.Sequencer"
    xmlns:logic="clr-namespace:NINA.Sequencer.Logic;assembly=NINA.Sequencer">
    <DataTemplate DataType="{x:Type local:BooleanCondition}">
        <nina:SequenceBlockView>
            <nina:SequenceBlockView.SequenceItemContent>
                <CheckBox Content="Continue" IsChecked="{Binding Enabled}" />
            </nina:SequenceBlockView.SequenceItemContent>
        </nina:SequenceBlockView>
    </DataTemplate>
    <DataTemplate x:Key="TemplateNamespace.Features.condition.BooleanCondition_Mini">
        <TextBlock Text="{Binding Name}" />
    </DataTemplate>
</ResourceDictionary>
