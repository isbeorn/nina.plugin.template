<ResourceDictionary x:Class="TemplateNamespace.Features.editor_integration.Resources"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="clr-namespace:TemplateNamespace.Features.editor_integration"
    xmlns:nina="clr-namespace:NINA.View.Sequencer;assembly=NINA.Sequencer"
    xmlns:logic="clr-namespace:NINA.Sequencer.Logic;assembly=NINA.Sequencer">
    <DataTemplate DataType="{x:Type local:CoupledInstruction}">
        <nina:SequenceBlockView>
            <nina:SequenceBlockView.SequenceItemContent>
                <StackPanel Orientation="Horizontal"><TextBlock Text="Square edge: " /><TextBox Width="70" Text="{Binding Width}" /><TextBlock Margin="10,0" Text="{Binding Height}" /></StackPanel>
            </nina:SequenceBlockView.SequenceItemContent>
        </nina:SequenceBlockView>
    </DataTemplate>
    <DataTemplate x:Key="TemplateNamespace.Features.editor_integration.CoupledInstruction_Mini">
        <TextBlock Text="{Binding Name}" />
    </DataTemplate>
</ResourceDictionary>
